---
interface Props { title?: string }
const { title = 'Đạo & Đời' } = Astro.props;
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!doctype html>
<html lang="vi" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Một khoảng đọc chậm cho đời sống, Đạo, Phật giáo và những kinh điển phương Đông." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Serif+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/pages.css" />
    <link rel="stylesheet" href="/styles/categories.css" />
    <link rel="stylesheet" href="/styles/topics.css" />
    <link rel="stylesheet" href="/styles/search-mobile.css" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
