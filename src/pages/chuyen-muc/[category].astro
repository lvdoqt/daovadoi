---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleThumbnail from '../../components/ArticleThumbnail.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/posts';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

// Lấy bài từ Content Collections thay vì posts.ts thủ công
const allPosts = await getCollection('blog');
const categoryPosts = allPosts
  .filter((post) => post.data.category === category.slug)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

function formatDate(dateStr: string) {
  const [y, m, d] = dateStr.split('-');
  return `${d}.${m}.${y}`;
}
---
<BaseLayout title={`${category.name} · Đạo & Đời`}>
  <main class="category-page wrap">
    <header>
      <p class="eyebrow">CHUYÊN MỤC</p>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
      {category.slug === 'dao-va-doi' && <p><a class="text-link" href="/trang-tu">TRANG TỬ · XEM CÂY SƠ ĐỒ <span aria-hidden="true">→</span></a></p>}
    </header>
    <div class="category-list">
      {categoryPosts.map((post, index) => (
        <a class={`category-card thumbnail-${index + 1}`} href={`/bai-viet/${post.id}`}>
          <span>0{index + 1}</span>
          <div class="thumbnail" aria-hidden="true">
            <ArticleThumbnail post={post} />
          </div>
          <div class="category-card__copy">
            <p class="eyebrow">{formatDate(post.data.date)}</p>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
