---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { trangTuStages, trangTuLessonCount } from '../data/trang-tu';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.series === 'trang-tu-doc-va-song' && post.data.category === 'dao-va-doi')
  .sort((a, b) => a.data.date.localeCompare(b.data.date) || a.id.localeCompare(b.id));
const published = new Map(posts.map((post) => [post.data.chapter, post]));
const availableCount = trangTuStages.flatMap((stage) => stage.lessons).filter((lesson) => published.has(lesson.number)).length;
const introduction = published.get(1);
---

<BaseLayout title="Trang Tử · Đọc để rộng lòng, sống để tự do · Đạo & Đời">
  <main class="zhuangzi wrap">
    <header class="trang-tu-hero">
      <p class="eyebrow">MỘT LƯỢT ĐỌC · NHIỀU CÁCH NHÌN</p>
      <h1>Trang Tử<br /><em>đọc để rộng lòng.</em></h1>
      <p class="lead">Theo cánh chim Bằng, dừng dưới một gốc cây, nghe một cuộc đối thoại còn bỏ ngỏ. Mỗi câu chuyện mở thêm một cách nhìn để ta trở về đời sống với lòng tự do hơn.</p>
      <div class="reading-stats"><strong>{availableCount}<span>/{trangTuLessonCount}</span></strong><span>bài đã có để đọc</span><span class="stat-divider" aria-hidden="true">·</span><span>{trangTuStages.length} chặng tuyển đọc</span></div>
      <div class="hero-links">
        {introduction && <a class="start-reading" href={`/bai-viet/${introduction.id}`}>Bắt đầu từ bài giới thiệu <span aria-hidden="true">→</span></a>}
        <a class="text-link" href="#so-do">XEM CÂY SƠ ĐỒ <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <section class="reading-map" id="so-do" aria-labelledby="so-do-title">
      <div class="map-heading">
        <div><p class="eyebrow">CÂY SƠ ĐỒ TRANG TỬ</p><h2 id="so-do-title">Từ một câu hỏi,<br />mở thêm những nhánh đọc.</h2></div>
        <p class="map-note">Đây là {trangTuLessonCount} bài tuyển đọc. Số bài đi theo hành trình của loạt; tên thiên gốc được ghi dưới từng bài.</p>
      </div>
      <div class="legend" aria-label="Chú thích sơ đồ"><span><i class="ready-dot" aria-hidden="true"></i>Có bài đọc</span>{availableCount < trangTuLessonCount && <span><i aria-hidden="true"></i>Trong kế hoạch</span>}</div>

      <div class="tree-root"><span class="root-mark" aria-hidden="true">莊</span><div><strong>Đọc để rộng lòng, sống để tự do</strong><p>{availableCount === trangTuLessonCount ? 'Đã đủ bài cho một lượt đọc. Chọn một nhánh để bắt đầu.' : 'Hành trình đang được viết tiếp, từng câu chuyện một.'}</p></div></div>
      <ol class="reading-tree" aria-label="Bốn chặng đọc Trang Tử">
        {trangTuStages.map((stage, index) => {
          const ready = stage.lessons.filter((lesson) => published.has(lesson.number)).length;
          return <li class="stage">
            <header class="stage-heading"><p class="eyebrow">CHẶNG {String(index + 1).padStart(2, '0')} <span>· {ready}/{stage.lessons.length} bài đã có</span></p><h3>{stage.title}</h3><p>{stage.description}</p></header>
            <ol class="branch-lessons" start={stage.lessons[0].number} aria-label={stage.title}>
              {stage.lessons.map((lesson) => {
                const post = published.get(lesson.number);
                const Tag = post ? 'a' : 'div';
                return <li class="leaf"><Tag class:list={['lesson', { 'is-ready': !!post, 'is-planned': !post }]} href={post ? `/bai-viet/${post.id}` : undefined}>
                  <span class="lesson-number">BÀI {String(lesson.number).padStart(2, '0')}</span>
                  <h4>{post?.data.title ?? lesson.title}</h4>
                  <p>{lesson.reading}</p>
                  <span class="lesson-state">{post ? 'Đọc bài' : 'Trong kế hoạch'}{post && <span aria-hidden="true">↗</span>}</span>
                </Tag></li>;
              })}
            </ol>
          </li>;
        })}
      </ol>
    </section>

    <section class="reading-invitation" aria-labelledby="doc-cham-title"><div><p class="eyebrow">ĐỌC CHẬM MỘT ĐOẠN</p><h2 id="doc-cham-title">Giữ lại điều<br /><em>khiến mình muốn hỏi.</em></h2></div><div><p>Chưa cần tìm một lời giải cho cả cuốn sách. Hãy bắt đầu từ người đang nói, hình ảnh đang hiện ra và một điều khiến mình ngạc nhiên. Các bài phân biệt phần kể lại văn bản với phần liên hệ đời thường.</p><a class="text-link" href="/chuyen-muc/dao-va-doi">ĐỌC THÊM ĐẠO & ĐỜI <span aria-hidden="true">→</span></a></div></section>
  </main>
</BaseLayout>

<style>
  .zhuangzi { padding: 5.5rem 0 6rem; }
  .trang-tu-hero { max-width: 820px; padding-bottom: 4.5rem; }
  h1,h2,h3,h4 { font-family: 'Noto Serif Display', serif; color: var(--forest); font-weight: 500; }
  h1 { font-size: clamp(3rem, 7vw, 5.8rem); line-height: 1.08; letter-spacing: -.05em; margin: 0; }
  .lead { max-width: 660px; font: 1.2rem/1.85 'Noto Serif Display', serif; margin: 1.8rem 0; }
  .reading-stats { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem; color: #606d65; font: 11px/1.6 'DM Mono', monospace; }
  .reading-stats strong { font: 2.7rem 'Noto Serif Display', serif; color: var(--forest); }
  .reading-stats strong span { font-size: 1.2rem; color: var(--clay); }
  .hero-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.7rem; }
  .start-reading { display: inline-flex; align-items: center; gap: 1.5rem; padding: 1rem 1.3rem; background: var(--forest); color: var(--paper); text-decoration: none; font: 13px/1.5 'DM Mono', monospace; }
  .start-reading:hover { background: #355b51; }
  a:focus-visible { outline: 3px solid var(--clay); outline-offset: 5px; }
  .reading-map { border-top: 1px solid var(--line); padding-top: 3.5rem; scroll-margin-top: 2rem; }
  .map-heading { display: grid; grid-template-columns: 1.3fr 1fr; align-items: end; gap: 3rem; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; }
  .map-note { max-width: 400px; margin: 0; color: #5c665e; font: 1rem/1.8 'Noto Serif Display', serif; }
  .legend { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 2rem 0 2.5rem; color: #5c665e; font: 11px/1.5 'DM Mono', monospace; }
  .legend span { display: inline-flex; align-items: center; gap: .5rem; }
  .legend i { width: 12px; height: 12px; border: 1px solid #8b9488; border-radius: 50%; }
  .legend .ready-dot { background: var(--forest); border-color: var(--forest); }
  .tree-root { display: flex; align-items: center; gap: 1.2rem; }
  .root-mark { display: grid; place-items: center; width: 56px; height: 56px; flex: 0 0 56px; border: 1px solid var(--forest); border-radius: 50%; background: var(--forest); color: var(--paper); font: 27px serif; }
  .tree-root strong { font: 500 1.4rem/1.4 'Noto Serif Display', serif; color: var(--forest); }
  .tree-root p { margin: .4rem 0 0; color: #5c665e; font: 14px/1.7 'Noto Serif Display', serif; }
  .reading-tree { list-style: none; margin: 0 0 0 28px; padding: 1rem 0 0 35px; border-left: 1px solid #aab3a4; }
  .stage { position: relative; padding: 2rem 0 2.5rem; }
  .stage::before { content: ''; position: absolute; top: 2.5rem; left: -36px; width: 25px; height: 1px; background: #aab3a4; }
  .stage::after { content: ''; position: absolute; left: -40px; top: calc(2.5rem - 4px); width: 7px; height: 7px; border: 1px solid #8b9488; border-radius: 50%; background: var(--paper); }
  .stage-heading .eyebrow { margin-bottom: .6rem; }
  .stage-heading .eyebrow span { color: #606d65; }
  .stage h3 { font-size: 1.7rem; line-height: 1.3; margin: 0; }
  .stage-heading > p:last-child { margin: .7rem 0 1.8rem; color: #5c665e; font: 1rem/1.7 'Noto Serif Display', serif; }
  .branch-lessons { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding: 1.25rem 0 0; margin: 0; position: relative; }
  .branch-lessons::before { content: ''; position: absolute; left: 0; right: 0; top: 0; border-top: 1px solid var(--line); }
  .leaf { position: relative; min-width: 0; }
  .leaf::before { content: ''; position: absolute; height: 1.25rem; border-left: 1px solid var(--line); top: -1.25rem; left: 1.3rem; }
  .lesson { display: flex; flex-direction: column; height: 100%; padding: 1.2rem; border: 1px solid var(--line); color: var(--forest); text-decoration: none; background: #f3ede2; }
  .lesson-number { font: 10px/1.5 'DM Mono', monospace; color: #766656; }
  .lesson h4 { font-size: 1.18rem; line-height: 1.5; margin: .85rem 0 .7rem; overflow-wrap: anywhere; }
  .lesson > p { font: 12px/1.65 'Noto Serif Display', serif; margin: 0 0 1.4rem; color: #5c665e; }
  .lesson-state { display: flex; justify-content: space-between; gap: .5rem; margin-top: auto; padding-top: .8rem; border-top: 1px solid var(--line); font: 10px/1.5 'DM Mono', monospace; color: #606d65; }
  .is-ready { background: var(--forest); border-color: var(--forest); }
  .is-ready h4 { color: #f7f2e9; }
  .is-ready .lesson-number,.is-ready > p { color: #e4d4bd; }
  .is-ready .lesson-state { color: #f7f2e9; border-color: #698179; }
  .is-ready:hover { background: #355b51; }
  .reading-invitation { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-top: 3.5rem; margin-top: 3rem; border-top: 1px solid var(--line); }
  .reading-invitation p:not(.eyebrow) { margin: 0 0 1.5rem; font: 1.05rem/1.85 'Noto Serif Display', serif; }
  @media (max-width: 900px) { .branch-lessons { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; } }
  @media (max-width: 720px) {
    .zhuangzi { padding: 3rem 0 4rem; }
    .trang-tu-hero { padding-bottom: 3rem; }
    .map-heading,.reading-invitation { grid-template-columns: 1fr; gap: 1.3rem; }
    .map-note { max-width: none; }
    .reading-map { padding-top: 2.5rem; }
    .tree-root strong { font-size: 1.15rem; }
    .reading-tree { margin-left: 20px; padding-left: 24px; }
    .root-mark { width: 40px; height: 40px; flex-basis: 40px; font-size: 22px; }
    .stage::before { left: -25px; width: 17px; }
    .stage::after { left: -29px; }
    .stage h3 { font-size: 1.5rem; }
  }
  @media (max-width: 520px) {
    .branch-lessons { grid-template-columns: 1fr; padding: 0 0 0 15px; border-left: 1px solid var(--line); gap: .8rem; }
    .branch-lessons::before { display: none; }
    .leaf::before { height: 1px; width: 15px; top: 1.5rem; left: -15px; border: 0; background: var(--line); }
    .hero-links { gap: 1.2rem; }
    .reading-stats { gap: .6rem; }
    .stat-divider { display: none; }
    .lesson h4 { font-size: 1.15rem; }
  }
</style>
