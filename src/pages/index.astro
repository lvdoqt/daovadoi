---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleThumbnail from '../components/ArticleThumbnail.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/posts';

// Lấy tất cả bài, sắp xếp mới nhất trước
const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.localeCompare(a.data.date));

// Bài nổi bật (mới nhất)
const featured = sorted[0];
const [fy, fm, fd] = featured.data.date.split('-');
const featuredDate = `${fd}.${fm}.${fy}`;
const featuredCat = categories.find((c) => c.slug === featured.data.category);

// 3 bài gần đây (bỏ bài featured)
const recent = sorted.slice(1, 4);

function formatDate(d: string) {
  const [y, m, dd] = d.split('-');
  return `${dd}.${m}.${y}`;
}
function getCatName(slug: string) {
  return categories.find((c) => c.slug === slug)?.name ?? slug;
}
---
<BaseLayout>
  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">GHI CHÉP VỀ MỘT ĐỜI SỐNG TỈNH THỨC</p>
        <h1>Đi qua đời sống<br /><em>bằng một trái tim sáng.</em></h1>
        <p class="intro">Một nơi để đọc chậm, nghĩ sâu và cùng nhau tìm lại những điều bình dị vẫn thường bị lãng quên.</p>
        <a class="text-link" href="#bai-viet">BẮT ĐẦU ĐỌC <span>↓</span></a>
      </div>
      <div class="hero-art" aria-label="Minh hoạ bình minh trên núi" role="img">
        <svg viewBox="0 0 600 520" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="sky" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#e7b692"/><stop offset="1" stop-color="#f6dfbd"/></linearGradient></defs>
          <rect width="600" height="520" fill="url(#sky)"/>
          <circle cx="383" cy="176" r="81" fill="#f9e8c9"/>
          <path d="M0 331C70 278 120 295 177 332c49-101 103-120 189-38 72-50 139-35 234 15v211H0Z" fill="#a96753"/>
          <path d="M0 385c81-77 153-63 234 3 80-44 168-51 366 10v122H0Z" fill="#593e3a"/>
          <path d="M70 447c48-24 99-16 146 13 59-40 130-43 209 4 54-31 113-26 175 7v49H0v-44c24-17 45-28 70-29Z" fill="#263c36"/>
          <g stroke="#f6dfbd" stroke-width="2" opacity=".65"><path d="M101 95h100"/><path d="M449 71h73"/><path d="M75 137h53"/></g>
          <text x="48" y="476" fill="#f6dfbd" font-family="serif" font-size="19" font-style="italic">an trú giữa đời thường</text>
        </svg>
      </div>
    </section>

    <section class="topics wrap" id="chuyen-muc">
      <p class="eyebrow">CHỌN MỘT LỐI ĐI</p>
      <div class="topic-grid">
        <a href="/chuyen-muc/cuoc-song" class="topic"><span>01</span><strong>Cuộc sống</strong><i>↗</i></a>
        <a href="/chuyen-muc/dao-va-doi" class="topic"><span>02</span><strong>Đạo & đời</strong><i>↗</i></a>
        <a href="/chuyen-muc/phat-giao" class="topic"><span>03</span><strong>Phật giáo</strong><i>↗</i></a>
        <a href="/chuyen-muc/dao-duc-kinh" class="topic"><span>04</span><strong>Đạo Đức Kinh</strong><i>↗</i></a>
        <a href="/chuyen-muc/kinh-dich" class="topic"><span>05</span><strong>Kinh Dịch</strong><i>↗</i></a>
        <a href="/chuyen-muc/thien-va-thuc-hanh" class="topic"><span>06</span><strong>Thiền & thực hành</strong><i>↗</i></a>
      </div>
    </section>

    <section class="ddk-home wrap" aria-labelledby="ddk-home-title">
      <div><p class="eyebrow">HÀNH TRÌNH ĐẠO ĐỨC KINH</p><h2 id="ddk-home-title">81 chương,<br /><em>đọc để sống được.</em></h2></div>
      <div><p>Mỗi ngày ba chương được diễn giải bằng tiếng Việt gần gũi, nối với những câu hỏi của đời sống hôm nay.</p><a class="text-link" href="/dao-duc-kinh">XEM SƠ ĐỒ CHƯƠNG <span>→</span></a></div>
    </section>

    <section class="ddk-home wrap" aria-labelledby="trang-tu-home-title">
      <div><p class="eyebrow">HÀNH TRÌNH TRANG TỬ</p><h2 id="trang-tu-home-title">Đọc để rộng lòng,<br /><em>sống để tự do.</em></h2></div>
      <div><p>Một lượt tuyển đọc qua những câu chuyện và cuộc đối thoại. Theo cây sơ đồ, chọn một bài để mở thêm cách nhìn về đời sống.</p><a class="text-link" href="/trang-tu">KHÁM PHÁ TRANG TỬ <span>→</span></a></div>
    </section>

    <section class="featured" id="bai-viet">
      <div class="wrap feature-layout">
        <div class="feature-art">
          <ArticleThumbnail post={featured} variant="hero" />
        </div>
        <article class="feature-copy">
          <p class="eyebrow">BÀI VIẾT MỚI NHẤT · {featuredDate}</p>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.excerpt}</p>
          <a class="text-link" href={`/bai-viet/${featured.id}`}>ĐỌC TIẾP <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="journal wrap">
      <div class="section-head"><div><p class="eyebrow">NHỮNG GHI CHÉP GẦN ĐÂY</p><h2>Đọc để trở về.</h2></div><a class="text-link" href="/chuyen-muc/cuoc-song">XEM TẤT CẢ <span>→</span></a></div>
      <div class="article-grid">
        {recent.map((post) => <article class="card">
          <div class="card-art">
            <ArticleThumbnail post={post} variant="card" />
          </div>
          <div class="card-meta"><span>{getCatName(post.data.category)}</span><time>{formatDate(post.data.date)}</time></div>
          <h3>{post.data.title}</h3><p>{post.data.excerpt}</p>
          <a href={`/bai-viet/${post.id}`} aria-label={`Đọc ${post.data.title}`}>Đọc bài <span>→</span></a>
        </article>)}
      </div>
    </section>

    <section class="video-section" id="video"><div class="wrap video-wrap"><div><p class="eyebrow">MỘT KHOẢNG LẮNG NGHE</p><h2>Những cuộc<br /><em>trò chuyện chậm.</em></h2><p>Video, âm thanh và những mẩu đối thoại dành cho một buổi chiều lắng lại.</p><a class="text-link" href="/video">XEM VIDEO <span>→</span></a></div><a class="video-card" href="/video" aria-label="Xem video mới nhất"><svg viewBox="0 0 500 310" xmlns="http://www.w3.org/2000/svg"><rect width="500" height="310" fill="#5a766b"/><circle cx="252" cy="151" r="100" fill="#d8c18f"/><path d="M252 51v200M152 151h200" stroke="#f2e9d5" stroke-width="1"/><path d="M214 120l66 31-66 39Z" fill="#fff8e9"/></svg><span class="play" aria-hidden="true">▶</span><span>Nhấn để xem video</span></a></div></section>
  </main>
</BaseLayout>

<style>
.ddk-home { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:end; padding:5rem 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.ddk-home h2 { font-size:clamp(2.7rem,4.5vw,4rem); }.ddk-home p:not(.eyebrow) { max-width:420px; font:1.1rem/1.75 'Noto Serif Display',serif; margin:0 0 1.5rem; color:#59645c; }
@media(max-width:720px) { .ddk-home { grid-template-columns:1fr; gap:1.5rem; padding:3.5rem 0; } }
</style>
