---
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = [
  { category: 'Đạo & đời', date: '18.08.2026', title: 'Làm sao để sống một ngày không vội?', excerpt: 'Chậm lại không phải là bỏ cuộc. Đó là cách ta trở về với nhịp điệu riêng của mình.', type: 'mountain' },
  { category: 'Phật giáo', date: '12.08.2026', title: 'Chánh niệm bắt đầu từ một hơi thở', excerpt: 'Không cần tìm kiếm ở nơi xa. Sự tỉnh thức luôn có mặt trong việc nhỏ nhất.', type: 'sun' },
  { category: 'Kinh dịch', date: '06.08.2026', title: 'Quẻ Càn và sức mạnh của sự khởi đầu', excerpt: 'Một cuộc đọc giản dị về sáu hào dương và tinh thần tự cường trong đời sống.', type: 'lines' }
];
---
<BaseLayout>
  <main>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">GHI CHÉP VỀ MỘT ĐỜI SỐNG TỈNH THỨC</p>
        <h1>Đi qua đời sống<br /><em>bằng một trái tim sáng.</em></h1>
        <p class="intro">Một nơi để đọc chậm, nghĩ sâu và cùng nhau tìm lại những điều bình dị vẫn thường bị lãng quên.</p>
        <a class="text-link" href="#bai-viet">BẮT ĐẦU ĐỌC <span>↓</span></a>
      </div>
      <div class="hero-art" aria-label="Minh hoạ bình minh trên núi" role="img">
        <svg viewBox="0 0 600 520" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="sky" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#e7b692"/><stop offset="1" stop-color="#f6dfbd"/></linearGradient></defs>
          <rect width="600" height="520" fill="url(#sky)"/>
          <circle cx="383" cy="176" r="81" fill="#f9e8c9"/>
          <path d="M0 331C70 278 120 295 177 332c49-101 103-120 189-38 72-50 139-35 234 15v211H0Z" fill="#a96753"/>
          <path d="M0 385c81-77 153-63 234 3 80-44 168-51 366 10v122H0Z" fill="#593e3a"/>
          <path d="M70 447c48-24 99-16 146 13 59-40 130-43 209 4 54-31 113-26 175 7v49H0v-44c24-17 45-28 70-29Z" fill="#263c36"/>
          <g stroke="#f6dfbd" stroke-width="2" opacity=".65"><path d="M101 95h100"/><path d="M449 71h73"/><path d="M75 137h53"/></g>
          <text x="48" y="476" fill="#f6dfbd" font-family="serif" font-size="19" font-style="italic">an trú giữa đời thường</text>
        </svg>
      </div>
    </section>

    <section class="topics wrap" id="chuyen-muc">
      <p class="eyebrow">CHỌN MỘT LỐI ĐI</p>
      <div class="topic-grid">
        <a href="/chuyen-muc/cuoc-song" class="topic"><span>01</span><strong>Cuộc sống</strong><i>↗</i></a>
        <a href="/chuyen-muc/dao-va-doi" class="topic"><span>02</span><strong>Đạo & đời</strong><i>↗</i></a>
        <a href="/chuyen-muc/phat-giao" class="topic"><span>03</span><strong>Phật giáo</strong><i>↗</i></a>
        <a href="/chuyen-muc/dao-duc-kinh" class="topic"><span>04</span><strong>Đạo Đức Kinh</strong><i>↗</i></a>
        <a href="/chuyen-muc/kinh-dich" class="topic"><span>05</span><strong>Kinh Dịch</strong><i>↗</i></a>
        <a href="/chuyen-muc/thien-va-thuc-hanh" class="topic"><span>06</span><strong>Thiền & thực hành</strong><i>↗</i></a>
      </div>
    </section>

    <section class="featured" id="bai-viet">
      <div class="wrap feature-layout">
        <div class="feature-art"><svg viewBox="0 0 600 560" xmlns="http://www.w3.org/2000/svg"><rect width="600" height="560" fill="#c9d3be"/><circle cx="301" cy="262" r="149" fill="none" stroke="#375248" stroke-width="2"/><circle cx="301" cy="262" r="105" fill="#e6c899"/><path d="M301 112v300M151 262h300" stroke="#375248" stroke-width="2"/><path d="M301 154c-20 54-19 110 0 165 21-55 20-111 0-165Zm-108 108c55-20 111-19 166 0-55 21-111 20-166 0Zm216 0c55-20 111-19 166 0-55 21-111 20-166 0Z" fill="#46675a"/><text x="300" y="505" text-anchor="middle" fill="#375248" font-size="18" font-family="serif" letter-spacing="4">TĨNH</text></svg></div>
        <article class="feature-copy">
          <p class="eyebrow">BÀI VIẾT MỚI NHẤT · 20.08.2026</p>
          <h2>Khoảng lặng<br />giữa những điều<br /><em>đang diễn ra.</em></h2>
          <p>Ta thường đợi đến khi mọi thứ ổn thỏa mới cho phép mình bình an. Nhưng bình an không phải là đích đến — nó là một cách có mặt, ngay trong lúc này.</p>
          <a class="text-link" href="/khoang-lang-giua-nhung-dieu-dang-dien-ra">ĐỌC TIẾP <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="journal wrap">
      <div class="section-head"><div><p class="eyebrow">NHỮNG GHI CHÉP GẦN ĐÂY</p><h2>Đọc để trở về.</h2></div><a class="text-link" href="#">XEM TẤT CẢ <span>→</span></a></div>
      <div class="article-grid">
        {articles.map((article) => <article class="card">
          <div class={`card-art ${article.type}`}>
            {article.type === 'mountain' && <svg viewBox="0 0 340 230"><rect width="340" height="230" fill="#d4c7b1"/><circle cx="255" cy="67" r="38" fill="#f1e4c9"/><path d="M0 177 86 95l41 44 54-79 159 137v33H0Z" fill="#6b7b6a"/><path d="m0 200 116-61 43 45 65-74 116 87v33H0Z" fill="#415950"/></svg>}
            {article.type === 'sun' && <svg viewBox="0 0 340 230"><rect width="340" height="230" fill="#b7c8bd"/><circle cx="170" cy="112" r="62" fill="#f4dc9e"/><g stroke="#486259" stroke-width="3"><path d="M170 16v36M170 172v40M74 112h36M230 112h36M102 44l26 26M212 154l27 28M238 44l-26 26M128 154l-27 28"/></g></svg>}
            {article.type === 'lines' && <svg viewBox="0 0 340 230"><rect width="340" height="230" fill="#d8b998"/><g stroke="#473d37" stroke-width="11"><path d="M100 57h140M100 92h62m16 0h62M100 127h62m16 0h62M100 162h140"/></g><circle cx="170" cy="112" r="85" fill="none" stroke="#473d37" stroke-width="1"/></svg>}
          </div>
          <div class="card-meta"><span>{article.category}</span><time>{article.date}</time></div>
          <h3>{article.title}</h3><p>{article.excerpt}</p><a href={article.type === 'mountain' ? '/mot-ngay-khong-voi' : article.type === 'sun' ? '/chanh-niem-mot-hoi-tho' : '/que-can-suc-manh-khoi-dau'} aria-label={`Đọc ${article.title}`}>Đọc bài <span>→</span></a>
        </article>)}
      </div>
    </section>

    <section class="video-section" id="video"><div class="wrap video-wrap"><div><p class="eyebrow">MỘT KHOẢNG LẮNG NGHE</p><h2>Những cuộc<br /><em>trò chuyện chậm.</em></h2><p>Video, âm thanh và những mẩu đối thoại dành cho một buổi chiều lắng lại.</p><a class="text-link" href="#">XEM KÊNH VIDEO <span>→</span></a></div><div class="video-card"><svg viewBox="0 0 500 310" xmlns="http://www.w3.org/2000/svg"><rect width="500" height="310" fill="#5a766b"/><circle cx="252" cy="151" r="100" fill="#d8c18f"/><path d="M252 51v200M152 151h200" stroke="#f2e9d5" stroke-width="1"/><path d="M214 120l66 31-66 39Z" fill="#fff8e9"/></svg><button class="play" aria-label="Phát video">▶</button><span>12:48 · Một buổi sáng không lịch trình</span></div></div></section>
  </main>
</BaseLayout>
