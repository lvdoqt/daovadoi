---
import { categories, posts } from '../data/posts';
---
<header class="site-header wrap"><a class="wordmark" href="/">ĐẠO <span>&</span> ĐỜI</a><nav aria-label="Chuyên mục">{categories.map((category) => <a href={`/chuyen-muc/${category.slug}`}>{category.name}</a>)}</nav><button class="menu search-toggle" type="button" aria-label="Tìm kiếm" aria-expanded="false">⌕</button></header>
<dialog class="search-panel"><div class="search-panel__inner"><button class="search-close" type="button" aria-label="Đóng">×</button><p class="eyebrow">TÌM TRONG ĐẠO & ĐỜI</p><label><span class="sr-only">Từ khoá</span><input class="search-input" type="search" placeholder="Nhập tên bài viết hoặc chuyên mục…" autofocus /></label><div class="search-results">{posts.map((post) => <a href={`/${post.slug}`} data-search={`${post.title} ${post.excerpt} ${post.category}`.toLocaleLowerCase()}><span>{categories.find((item) => item.slug === post.category)?.name}</span>{post.title}<b>→</b></a>)}</div></div></dialog>
<script>const panel=document.querySelector('.search-panel'),toggle=document.querySelector('.search-toggle'),close=document.querySelector('.search-close'),input=document.querySelector('.search-input'),results=[...document.querySelectorAll('[data-search]')];toggle?.addEventListener('click',()=>{panel?.showModal();toggle.setAttribute('aria-expanded','true');input?.focus()});close?.addEventListener('click',()=>{panel?.close();toggle?.setAttribute('aria-expanded','false')});panel?.addEventListener('click',(event)=>{if(event.target===panel)panel.close()});input?.addEventListener('input',()=>{const query=input.value.toLocaleLowerCase().trim();results.forEach((item)=>{item.hidden=!item.dataset.search?.includes(query)})});</script>
